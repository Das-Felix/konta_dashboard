# Postgres-Verbindung zur Konta-Datenbank. Bitte eine Rolle mit reinen
# Leserechten verwenden (SQL dazu im README). Das Dashboard schaltet jede
# Verbindung zusätzlich auf read-only.
DATABASE_URL="postgresql://konta_dashboard:PASSWORD@localhost:5432/buchhaltungssoftware"

# Signiert das Session-Cookie. Mindestens 32 Zeichen, z. B. `openssl rand -hex 32`.
SESSION_SECRET=""

# Konta-Konten, die sich anmelden dürfen (Anmeldung mit dem normalen
# Konta-Passwort). Kommagetrennt.
ADMIN_EMAILS="admin@konta.at"

# Gleicher Wert wie TWO_FACTOR_SECRET_KEY in der Konta-App. Nur nötig, wenn
# ein Admin-Konto 2FA aktiviert hat (empfohlen).
TWO_FACTOR_SECRET_KEY=""

# OpenPanel (Lesezugriff). Im OpenPanel-Projekt unter Einstellungen > Clients
# einen eigenen Client im Modus "read" anlegen, nicht den Tracking-Client der
# App wiederverwenden.
OPENPANEL_API_URL="https://api.openpanel.dev"
OPENPANEL_CLIENT_ID=""
OPENPANEL_CLIENT_SECRET=""
OPENPANEL_PROJECT_ID=""
# Optional: Projekt-URL im OpenPanel-Dashboard für Direktlinks zu Profilen.
OPENPANEL_DASHBOARD_URL=""

# Optional: Basis-URL der Konta-App.
KONTA_APP_URL="https://app.konta.at"
